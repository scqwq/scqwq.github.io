    <item>
      <title>AGENT</title>
      <link>http://localhost:1313/post/agent/</link>
      <pubDate>Sun, 03 May 2026 11:00:00 &#43;0800</pubDate>
      <author>xxx@example.com (D-Sketon)</author>
